# 将本文件复制为 .env，填写所需密钥；不要提交 .env。
# URL、超时、提示词等高级配置均已有默认值。

# 大模型、视觉、语音和向量功能必填。
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.8-max
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=Cherry
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding

# 可选：为通用天气工具提供中国城市实况。
# 旅行 Agent 的多日预报使用 Open-Meteo，无需密钥。
SENIVERSE_API_KEY=

# 可选：百度地图动态交通和景点数据，请申请个人服务端 AK。
# 未配置时 Bot 仍可运行，但不提供实时路线和 POI 数据。
BAIDU_MAP_AK=
BAIDU_MAP_MAX_POI_QUERIES=3

# 可选：铁路班次和参考票价，免费额度较少，默认关闭。
# 启用后会记录每日用量、自动熔断并缓存结果；超出查询日期范围时不调用接口。
JUHE_RAIL_ENABLED=false
JUHE_RAIL_API_KEY=
JUHE_RAIL_DAILY_LIMIT=10
JUHE_RAIL_CACHE_MINUTES=360

# 可选：中文 PDF 字体；程序会自动查找常见本地字体。
TRAVEL_PDF_FONT_PATH=

# 功能开关。
WECHAT_AUTO_REPLY_ENABLED=true
WECHAT_LLM_REPLY_ENABLED=true
TRAVEL_RAG_ENABLED=true
TRAVEL_CHECKPOINT_HOURS=6
