# Copy this file to .env, fill in the keys you need, and keep .env out of version control.
# The URLs, timeout values, prompts, and other advanced settings already have code defaults.

# Required for LLM, vision, speech, and embedding capabilities.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.8-max
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=Cherry
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding

# Optional: generic weather_query tool for current weather in Chinese cities.
# The travel Agent's multi-day forecast uses Open-Meteo and needs no API key.
SENIVERSE_API_KEY=

# Optional dynamic travel enrichment. Create a personal "server-side" AK on Baidu Maps.
# Without this key the bot keeps working and omits routes/POI live data.
BAIDU_MAP_AK=
BAIDU_MAP_MAX_POI_QUERIES=3

# Optional Chinese PDF font. Common local fonts are detected automatically.
TRAVEL_PDF_FONT_PATH=

# Feature switches.
WECHAT_AUTO_REPLY_ENABLED=true
WECHAT_LLM_REPLY_ENABLED=true
TRAVEL_RAG_ENABLED=true
